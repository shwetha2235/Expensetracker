import { useEffect, useState } from "react";
import { db } from "../firebase";
import { collection, onSnapshot } from "firebase/firestore";

function MonthlyReport() {
  const [report, setReport] = useState({});

  useEffect(() => {
    const unsubscribe = onSnapshot(
      collection(db, "transactions"),
      (snapshot) => {
        const monthlyData = {};

        snapshot.docs.forEach((doc) => {
          const data = doc.data();

          const month = new Date(data.date).toLocaleString("default", {
            month: "long",
            year: "numeric",
          });

          if (!monthlyData[month]) {
            monthlyData[month] = {
              income: 0,
              expense: 0,
            };
          }

          if (data.type === "income") {
            monthlyData[month].income += data.amount;
          } else {
            monthlyData[month].expense += data.amount;
          }
        });

        setReport(monthlyData);
      }
    );

    return () => unsubscribe();
  }, []);

  return (
    <div>
      <h2>Monthly Report</h2>

      {Object.keys(report).length === 0 ? (
        <p>No data available.</p>
      ) : (
        Object.keys(report).map((month) => (
          <div
            key={month}
            style={{
              border: "1px solid #ccc",
              padding: "15px",
              marginBottom: "10px",
              borderRadius: "8px",
            }}
          >
            <h3>{month}</h3>

            <p>Income : ₹{report[month].income}</p>

            <p>Expense : ₹{report[month].expense}</p>

            <p>
              Savings : ₹
              {report[month].income - report[month].expense}
            </p>
          </div>
        ))
      )}
    </div>
  );
}

export default MonthlyReport;
